{
  "name": "daymark-desktop",
  "version": "1.9.1",
  "description": "A calm, focused desktop to-do list.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.daymark.desktop",
    "productName": "em cheyali bhaii",
    "files": [
      "main.js",
      "google-tasks.js",
      "canvas.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "anime.umd.min.js",
      "grain.svg"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
